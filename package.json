{
  "name": "aashray-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "check:content": "node scripts/check-content.mjs",
    "sync:notion": "node scripts/sync-notion.mjs",
    "check:dist": "node scripts/check-content.mjs --dist",
    "build:site": "astro build && pagefind --site dist && node scripts/add-security-policy.mjs",
    "build": "npm run check:content && npm run build:site && npm run check:dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "astro": "7.4.12",
    "astro-expressive-code": "0.44.3",
    "he": "2.0.0",
    "parse5": "8.1.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "sharp": "0.35.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@notionhq/client": "^2.2.15",
    "notion-to-md": "^3.1.4",
    "pagefind": "^1.3.0"
  }
}
